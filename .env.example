# Reputation Scout reads these from the environment of the MCP server process.
# Set them in your MCP client's "env" block (see README). All are optional.

# Optional search keys. Tried first when set; otherwise search falls back to
# Bing, then Parallel and Firecrawl (hosted, key-free), then DuckDuckGo.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Added to the User-Agent of public-API calls (the SEC asks callers to identify themselves).
REPSCOUT_CONTACT_EMAIL=

# Hosted key-free search sends the query to Parallel/Firecrawl. "false" keeps searches local.
REPSCOUT_HOSTED_SEARCH=true
# Opt-in: let Firecrawl read pages other readers can't (G2, Glassdoor). Check those sites' terms first.
REPSCOUT_HOSTED_SCRAPE=false

# Jina Reader fallback for bot-walled pages. Disable with "false"; the key raises the rate limit.
REPSCOUT_JINA_FALLBACK=true
JINA_API_KEY=

# Where run state, the page cache and finished reports are written.
REPSCOUT_CACHE_DIR=
REPSCOUT_REPORTS_DIR=
